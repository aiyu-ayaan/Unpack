{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unpack",
  "version": "0.0.1-alpha.3",
  "identifier": "dev.unpack.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Unpack",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": false,
        "backgroundColor": "#1f1f1f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://dl.flathub.org; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Install anything on Linux",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/polkit-1/actions/dev.unpack.app.helper.policy": "polkit/dev.unpack.app.helper.policy"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/polkit-1/actions/dev.unpack.app.helper.policy": "polkit/dev.unpack.app.helper.policy"
        }
      }
    }
  }
}
