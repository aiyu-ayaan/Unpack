{
  "name": "unpack-workspace",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter unpack tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:web": "pnpm --filter unpack dev",
    "build": "pnpm --filter unpack build",
    "tauri": "pnpm --filter unpack tauri",
    "test": "cargo test --no-default-features --manifest-path app/src-tauri/Cargo.toml",
    "lint": "cargo clippy --manifest-path app/src-tauri/Cargo.toml"
  }
}
